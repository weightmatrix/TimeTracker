    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوب لعرض وإدارة الجدول الزمني الخاص بك في الجدول الزمني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich, um Ihren Zeitplan auf der Zeitleiste anzuzeigen und zu verwalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required to display and manage your schedule on the timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para mostrar y gestionar su horario en la línea de tiempo."
